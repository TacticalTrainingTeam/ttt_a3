        </Key>
        <Key ID="STR_ttt_Resupply_quantityMultiplier_description">
            <English>Multiplier applied to the per-player average quantity of each item in the crate. 1.0 = one player worth.</English>
            <German>Multiplikator fuer die durchschnittliche Menge pro Spieler jedes Gegenstands in der Kiste. 1.0 = Ausruestung eines Spielers.</German>
        </Key>
        <Key ID="STR_ttt_Resupply_quantityMultiplier_displayName">
            <English>Quantity Multiplier</English>
